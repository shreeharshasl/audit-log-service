# Local environment overrides. Never commit real credentials.
.env
.env.local
application-local.yml
application-local.properties

# Signing keys. The service reads these from disk in dev; they must never be
# committed, and CI generates ephemeral ones.
*.pem
*.p8
keys/
!keys/.gitkeep

# Generated verification bundles and exports from local runs
/exports/
/out/

dependency-check-report.*

# Generated by maven-shade-plugin during packaging
dependency-reduced-pom.xml
